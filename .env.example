# AREE Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# AbuseIPDB API Key (optional - threat intelligence)
ABUSEIPDB_KEY=your_abuseipdb_api_key_here

# Slack Integration (optional - alerts)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_CHANNEL=#aree-alerts
RE_ALERT_THRESHOLD=75.0

# Monitoring Configuration (optional)
MONITORING_INTERVAL=10
MONITORING_MODE=SUGGEST
